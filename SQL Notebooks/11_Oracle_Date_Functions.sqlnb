    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      TO_CHAR(INTERVAL '600' SECOND, 'HH24:MM') result
      FROM
      DUAL;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      first_name,
      last_name,
      TO_CHAR(hire_date, 'Q') joined_quarter
      FROM
      employees
      WHERE
      hire_date BETWEEN DATE '2016-01-01' AND date '2016-12-31'
      ORDER BY
      first_name, last_name;
    languageId: oracle-sql
